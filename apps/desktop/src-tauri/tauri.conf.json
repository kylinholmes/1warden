{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coffer",
  "version": "0.0.0",
  "identifier": "app.coffer.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Coffer",
        "width": 1080,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "connect-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "shortDescription": "个人密码管理器",
    "longDescription": "Coffer 是一个面向个人用户的密码管理器，后端对接自建的 Vaultwarden。",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
