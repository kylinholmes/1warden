{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "1Warden",
  "mainBinaryName": "1warden",
  "version": "0.1.0",
  "identifier": "app.onewarden.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "1Warden",
        "width": 1080,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "liquidGlassRegular",
            "sidebar"
          ],
          "state": "active"
        },
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "quick",
        "title": "1Warden",
        "url": "quick.html",
        "transparent": true,
        "width": 620,
        "height": 400,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "focus": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "connect-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "category": "Utility",
    "shortDescription": "个人密码管理器",
    "longDescription": "1Warden 是一个面向个人用户的密码管理器，后端对接自建的 Vaultwarden。",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA1RkU5QTk3QkFFNjM5RjMKUldUek9lYTZsNXIrQlF6UE1XWSsrV2RndXl6U2dnci9PdmNaenB0SWd3ZEFYMERpTFNmeFFvVjQK",
      "endpoints": [
        "https://github.com/kylinholmes/1warden/releases/latest/download/latest.json"
      ]
    }
  }
}
