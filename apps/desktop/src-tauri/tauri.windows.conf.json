{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "1Warden",
        "width": 1080,
        "height": 720,
        "minWidth": 360,
        "minHeight": 320,
        "resizable": true,
        "center": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "windowEffects": { "effects": [] }
      },
      {
        "label": "quick",
        "title": "1Warden",
        "url": "quick.html",
        "transparent": true,
        "shadow": false,
        "width": 620,
        "height": 400,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "focus": true
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
