{
  "name": "@coffer/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:mobile": "vite build -c vite.mobile.config.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "preview:build": "vite build -c vite.preview.config.ts",
    "preview:extension:build": "vite build -c vite.preview-extension.config.ts",
    "build:extension": "vite build -c vite.extension.config.ts && vite build -c vite.content.config.ts && COFFER_ENTRY=webauthn vite build -c vite.content.config.ts",
    "dev:extension": "vite build --watch -c vite.extension.config.ts & vite build --watch -c vite.content.config.ts & COFFER_ENTRY=webauthn vite build --watch -c vite.content.config.ts"
  },
  "dependencies": {
    "@coffer/api": "workspace:*",
    "@coffer/crypto": "workspace:*",
    "@coffer/vault": "workspace:*",
    "@tauri-apps/api": "2.12.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@coffer/ui": "workspace:*"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/chrome": "0.1.34",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.1.0",
    "tailwindcss": "4.1.14",
    "@tailwindcss/vite": "4.1.14",
    "vite": "8.3.2"
  }
}
